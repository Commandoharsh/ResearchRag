# Copy to .env. Never commit the real .env file.
LLM_PROVIDER=ollama

# Docker Compose service DNS; use http://localhost:11434 outside Docker.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=120

RAG_TOP_K=5
RAG_RETRIEVAL_K=20
RAG_FINAL_K=5
MAX_UPLOAD_SIZE_MB=25

# Replace with a long random value before any non-local deployment.
JWT_SECRET_KEY=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Browser URL used when building the frontend image.
VITE_API_URL=http://localhost:8000
